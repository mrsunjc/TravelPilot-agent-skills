{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/handoff-2.0.json",
  "title": "Travel Planner Agent Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "parent_handoff_id",
    "from_role",
    "to_role",
    "created_at",
    "task",
    "payload",
    "assumptions",
    "unresolved_issues",
    "resolved_issue_ids",
    "evidence_ids",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "parent_handoff_id": {"type": ["string", "null"]},
    "from_role": {"type": "string", "minLength": 1},
    "to_role": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning", "info"]}
        },
        "additionalProperties": true
      }
    },
    "resolved_issue_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
