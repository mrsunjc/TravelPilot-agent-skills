{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-planner.local/schemas/route-input-2.0.json",
  "title": "Travel Planner Route Input",
  "type": "object",
  "required": ["destination", "days", "attractions"],
  "properties": {
    "destination": {"type": "string", "minLength": 1},
    "days": {"type": "integer", "minimum": 1, "maximum": 30},
    "intensity": {"enum": ["light", "normal", "commando", "轻松游", "正常游", "特种兵游"]},
    "party": {
      "type": "object",
      "properties": {"size": {"type": "integer", "minimum": 1}},
      "additionalProperties": true
    },
    "attractions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attraction"}
    },
    "travel_times": {
      "type": "array",
      "items": {"$ref": "#/$defs/travelLeg"}
    },
    "lodging": {"$ref": "#/$defs/point"},
    "arrival_anchor": {"$ref": "#/$defs/point"},
    "departure_anchor": {"$ref": "#/$defs/point"}
  },
  "additionalProperties": true,
  "$defs": {
    "point": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
        "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
        "zone": {"type": "string"}
      },
      "additionalProperties": true
    },
    "attraction": {
      "allOf": [
        {"$ref": "#/$defs/point"},
        {
          "type": "object",
          "required": ["duration_minutes"],
          "properties": {
            "duration_minutes": {"type": "integer", "minimum": 1},
            "priority": {"enum": ["must", "recommended", "optional", "必去", "推荐", "可选"]},
            "available_days": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
          }
        }
      ]
    },
    "travelLeg": {
      "type": "object",
      "required": ["from", "to", "minutes"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "minutes": {"type": "number", "minimum": 0},
        "distance_km": {"type": ["number", "null"], "minimum": 0},
        "mode": {"type": "string"},
        "source": {"type": "string"},
        "verified": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
